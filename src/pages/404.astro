---
import Base from "../layouts/Base.astro";
import DayHeader from "../components/DayHeader.astro";
import { withBase } from "../lib/digests";
---
<Base title="Página não encontrada · Tech News" description="Página não encontrada.">
  <DayHeader />
  <main id="conteudo" class="page nf">
    <h1>Não existe edição neste endereço</h1>
    <p>O dia pode não ter tido resumo, ou o link está incompleto.</p>
    <p><a href={withBase("")}>Abrir a edição mais recente</a> ou <a href={withBase("arquivo/")}>ver todas as edições</a>.</p>
  </main>
</Base>
<style>
  .nf { padding-top: 2.5rem; max-width: 40rem; }
  h1 { font: 500 2rem/1.1 var(--serif); }
  a { text-decoration: underline; }
</style>

---
import {
  allDigests, neighbours, dayStrip, calendarMonths, SECTIONS,
  fullDate, dayMonth, dayUrl, withBase,
} from "../lib/digests";

// date ausente = páginas sem dia (arquivo, 404): só o cabeçalho, sem faixa nem seções.
interface Props { date?: string; count?: number; showSections?: boolean }
const { date, count, showSections = Boolean(date) } = Astro.props;

const all = allDigests();
const latest = all[0].date;
const current = date ?? latest;
const { newer, older } = neighbours(current);

// A faixa termina no dia mais recente; se o dia aberto estiver fora dela, termina 10 dias depois dele.
const STRIP = 30;
const addDays = (d: string, n: number) =>
  new Date(Date.parse(`${d}T12:00:00Z`) + n * 864e5).toISOString().slice(0, 10);
const end = current >= addDays(latest, -(STRIP - 1)) ? latest : addDays(current, 10) < latest ? addDays(current, 10) : latest;
const strip = dayStrip(end, STRIP);
const max = Math.max(...strip.map((d) => d.count ?? 0), 1);
const months = calendarMonths();
const longDate = (d: string) =>
  new Intl.DateTimeFormat("pt-BR", { timeZone: "UTC", weekday: "long", day: "numeric", month: "long", year: "numeric" })
    .format(new Date(`${d}T12:00:00Z`));
---
<header class="masthead page">
  <div class="top">
    <button class="link" type="button" popovertarget="calendario">Escolher dia</button>
    <a class="logo" href={withBase("")}>Tech News</a>
    <a class="link right" href={withBase("arquivo/")}>Todos os dias</a>
  </div>

  <div class="dateline">
    <span class="dl-date">{date ? longDate(date) : "Arquivo de edições"}</span>
    {date && <span class="dl-mid">{date === latest ? "Edição mais recente" : `Edição de ${dayMonth(date)}`}</span>}
    {count !== undefined && <span class="dl-count">{count} notícias</span>}
  </div>

  {showSections && (
    <nav class="sections" aria-label="Seções">
      <ul>
        {SECTIONS.map((s) => <li><a href={`#${s.id}`}>{s.name}</a></li>)}
        <li><a href="#para-ler">Para ler com calma</a></li>
      </ul>
    </nav>
  )}

  {date && (
    <div class="days">
      <ol class="strip" aria-label="Últimos dias">
        {strip.map((d) => (
          <li class:list={["bar", { current: d.date === date, empty: d.count === null }]}>
            {d.count === null ? (
              <span class="col">
                <span class="fill"></span>
                <span class="n" aria-hidden="true">{Number(d.date.slice(8))}</span>
                <span class="visually-hidden">{fullDate(d.date)}: sem edição</span>
              </span>
            ) : (
              <a class="col" href={dayUrl(d.date)} aria-current={d.date === date ? "page" : undefined}>
                <span class={`fill h${Math.round((d.count / max) * 10)}`}></span>
                <span class="n" aria-hidden="true">{Number(d.date.slice(8))}</span>
                <span class="visually-hidden">{fullDate(d.date)}: {d.count} notícias</span>
              </a>
            )}
          </li>
        ))}
      </ol>
      <nav class="pager" aria-label="Navegar entre edições">
        {older ? <a href={dayUrl(older)} rel="prev">‹ {dayMonth(older)}</a> : <span></span>}
        {newer ? <a href={dayUrl(newer)} rel="next">{dayMonth(newer)} ›</a> : <span></span>}
      </nav>
    </div>
  )}
</header>

<div id="calendario" popover class="calendar" aria-label="Escolher dia">
  <div class="cal-head">
    <p class="cal-title">Escolha uma edição</p>
    <button class="link" type="button" popovertarget="calendario" popovertargetaction="hide">Fechar</button>
  </div>
  {months.map((m) => (
    <section class="month" aria-label={m.label}>
      <h2>{m.label}</h2>
      <div class="grid" role="presentation">
        {["seg", "ter", "qua", "qui", "sex", "sáb", "dom"].map((w) => <span class="wd" aria-hidden="true">{w}</span>)}
        {m.cells.map((c) =>
          c === null ? <span></span> :
          c.has ? (
            <a href={dayUrl(c.date)} class:list={["d", { sel: c.date === date }]} aria-label={fullDate(c.date)} aria-current={c.date === date ? "date" : undefined}>{c.day}</a>
          ) : (
            <span class="d off" aria-hidden="true">{c.day}</span>
          )
        )}
      </div>
    </section>
  ))}
</div>

<style>
  .masthead { padding-top: 0.75rem; }

  .top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem;
  }
  .link {
    font: 600 0.72rem/1.2 var(--sans);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink);
    background: none;
    border: 0;
    padding: 0.4rem 0;
    cursor: pointer;
    justify-self: start;
  }
  .link:hover { color: var(--link-hover); }
  .right { justify-self: end; }

  .logo {
    font-family: var(--blackletter);
    font-size: clamp(2.6rem, 9vw, 4.6rem);
    line-height: 1;
    padding-block: 0.6rem 0.4rem;
    white-space: nowrap;
  }
  .logo:hover { color: inherit; }

  .dateline {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
    padding-block: 0.45rem;
    border-top: 1px solid var(--rule);
    border-bottom: 3px double var(--rule-strong);
    font: 600 0.75rem/1.3 var(--sans);
  }
  .dl-date::first-letter { text-transform: uppercase; }
  .dl-mid { color: var(--muted); font-weight: 500; }
  .dl-count { justify-self: end; }

  .sections ul {
    list-style: none;
    margin: 0;
    padding: 0.55rem 0;
    display: flex;
    justify-content: center;
    gap: 0.4rem 1.6rem;
    flex-wrap: wrap;
    font: 500 0.82rem/1.3 var(--sans);
    border-bottom: 1px solid var(--rule);
  }

  /* faixa de dias: cada barra é uma edição; a altura é o número de notícias */
  .days {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 1.5rem;
    padding-block: 0.9rem 0.4rem;
    border-bottom: 1px solid var(--rule);
  }
  .strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(30, minmax(0.9rem, 1fr));
    gap: 2px;
  }
  .col {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 3.25rem;
    gap: 3px;
  }
  .fill { display: block; background: var(--rule); min-height: 2px; }
  a.col:hover .fill { background: var(--muted); }
  .current .fill { background: var(--ink); }
  .empty .fill { height: 2px; }
  .n {
    font: 500 0.62rem/1 var(--sans);
    text-align: center;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .current .n { color: var(--ink); font-weight: 800; }
  .h0 { height: 8%; } .h1 { height: 12%; } .h2 { height: 20%; } .h3 { height: 28%; }
  .h4 { height: 36%; } .h5 { height: 44%; } .h6 { height: 52%; } .h7 { height: 58%; }
  .h8 { height: 64%; } .h9 { height: 70%; } .h10 { height: 76%; }

  .pager {
    display: flex;
    gap: 1.25rem;
    font: 600 0.78rem/1.2 var(--sans);
    white-space: nowrap;
    padding-bottom: 1rem;
  }

  @media (max-width: 40rem) {
    .top { grid-template-columns: 1fr 1fr; }
    .logo { grid-column: 1 / -1; grid-row: 1; justify-self: center; }
    .dateline { grid-template-columns: 1fr auto; }
    .dl-mid { display: none; }
    .sections ul { justify-content: flex-start; flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; white-space: nowrap; }
    .days { grid-template-columns: 1fr; gap: 0.5rem; }
    .strip { grid-template-columns: repeat(14, 1fr); }
    .bar:nth-child(-n + 16) { display: none; }
    .pager { justify-content: space-between; padding-bottom: 0; }
  }

  /* calendário (popover nativo, sem JS) */
  .calendar {
    width: min(22rem, calc(100vw - 2rem));
    max-height: min(32rem, calc(100vh - 2rem));
    overflow-y: auto;
    padding: 1rem 1.1rem 1.25rem;
    border: 1px solid var(--rule-strong);
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 16px 40px -16px rgb(0 0 0 / 0.4);
  }
  .calendar::backdrop { background: rgb(0 0 0 / 0.3); }
  .cal-head {
    display: flex; justify-content: space-between; align-items: center;
    padding-bottom: 0.5rem;
    border-bottom: 3px double var(--rule-strong);
  }
  .cal-title { margin: 0; font: 700 1.1rem/1.2 var(--serif); }
  .month h2 { font: 600 0.72rem/1.2 var(--sans); letter-spacing: 0.06em; text-transform: uppercase; margin: 1rem 0 0.4rem; }
  .grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 2px;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .wd { font: 500 0.68rem/1 var(--sans); color: var(--muted); padding-bottom: 0.3rem; }
  .d { display: grid; place-items: center; aspect-ratio: 1; font: 500 0.88rem/1 var(--sans); }
  a.d { font-weight: 700; border: 1px solid var(--rule); }
  a.d:hover { border-color: var(--ink); color: var(--ink); }
  a.d.sel { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .off { color: var(--muted); opacity: 0.4; }
</style>

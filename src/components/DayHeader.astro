---
import {
  allDigests, neighbours, dayStrip, calendarMonths,
  weekday, dayMonth, year, fullDate, dayUrl, withBase,
} from "../lib/digests";

interface Props { date: string; count: number }
const { date, count } = Astro.props;

const all = allDigests();
const latest = all[0].date;
const { newer, older } = neighbours(date);

// A faixa termina no dia mais recente; se o dia aberto estiver fora dela, termina 10 dias depois dele.
const STRIP = 30;
const addDays = (d: string, n: number) =>
  new Date(Date.parse(`${d}T12:00:00Z`) + n * 864e5).toISOString().slice(0, 10);
const end = date >= addDays(latest, -(STRIP - 1)) ? latest : addDays(date, 10) < latest ? addDays(date, 10) : latest;
const strip = dayStrip(end, STRIP);
const max = Math.max(...strip.map((d) => d.count ?? 0), 1);
const months = calendarMonths();
const isLatest = date === latest;
---
<header class="day-header">
  <div class="wrap">
    <nav class="top" aria-label="Site">
      <a class="brand" href={withBase("")}>Tech News</a>
      <div class="actions">
        <button class="btn" type="button" popovertarget="calendario">Escolher dia</button>
        <a class="btn" href={withBase("arquivo/")}>Todos os dias</a>
      </div>
    </nav>

    <p class="weekday">{isLatest ? `${weekday(date)}, resumo mais recente` : weekday(date)}</p>
    <h1 class="date">
      <span class="dm">{dayMonth(date)}</span>
      <span class="yr">{year(date)}</span>
    </h1>

    <ol class="strip" aria-label="Últimos dias">
      {strip.map((d) => (
        <li class:list={["bar", { current: d.date === date, empty: d.count === null }]}>
          {d.count === null ? (
            <span class="col" title={`${fullDate(d.date)}: sem resumo`}>
              <span class="fill"></span>
              <span class="n" aria-hidden="true">{Number(d.date.slice(8))}</span>
              <span class="visually-hidden">{fullDate(d.date)}: sem resumo</span>
            </span>
          ) : (
            <a class="col" href={dayUrl(d.date)} aria-current={d.date === date ? "page" : undefined}>
              <span class={`fill h${Math.round((d.count / max) * 10)}`}></span>
              <span class="n" aria-hidden="true">{Number(d.date.slice(8))}</span>
              <span class="visually-hidden">{fullDate(d.date)}: {d.count} notícias</span>
            </a>
          )}
        </li>
      ))}
    </ol>

    <nav class="pager" aria-label="Navegar entre dias">
      {older ? <a href={dayUrl(older)} rel="prev">‹ {dayMonth(older)}</a> : <span></span>}
      <span class="count">{count} notícias</span>
      {newer ? <a href={dayUrl(newer)} rel="next">{dayMonth(newer)} ›</a> : <span></span>}
    </nav>
  </div>

  <div id="calendario" popover class="calendar" aria-label="Escolher dia">
    <div class="cal-head">
      <p class="cal-title">Escolha um dia</p>
      <button class="btn" type="button" popovertarget="calendario" popovertargetaction="hide">Fechar</button>
    </div>
    {months.map((m) => (
      <section class="month" aria-label={m.label}>
        <h2>{m.label}</h2>
        <div class="grid" role="presentation">
          {["seg", "ter", "qua", "qui", "sex", "sáb", "dom"].map((w) => <span class="wd" aria-hidden="true">{w}</span>)}
          {m.cells.map((c) =>
            c === null ? <span></span> :
            c.has ? (
              <a href={dayUrl(c.date)} class:list={["d", { sel: c.date === date }]} aria-label={fullDate(c.date)} aria-current={c.date === date ? "date" : undefined}>{c.day}</a>
            ) : (
              <span class="d off" aria-hidden="true">{c.day}</span>
            )
          )}
        </div>
      </section>
    ))}
  </div>
</header>

<style>
  .day-header { padding-block: 1rem 0.5rem; }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .brand {
    font-weight: 750;
    font-stretch: 112%;
    text-decoration: none;
    font-size: var(--t-md);
  }
  .actions { display: flex; gap: 0.5rem; }
  .btn {
    font: inherit;
    font-size: var(--t-sm);
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
    cursor: pointer;
    text-decoration: none;
    line-height: 1.3;
  }
  .btn:hover { border-color: var(--muted); }

  .weekday {
    margin: 2.25rem 0 0;
    color: var(--muted);
    font-size: var(--t-sm);
  }
  .weekday::first-letter { text-transform: uppercase; }

  .date {
    margin: 0.1rem 0 1.25rem;
    font-weight: 800;
    font-stretch: 125%;
    font-size: clamp(3rem, 13vw, 6.25rem);
    line-height: 0.92;
    letter-spacing: -0.035em;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 0.3em;
  }
  .yr {
    font-weight: 300;
    font-stretch: 75%;
    color: var(--muted);
    font-size: 0.42em;
    letter-spacing: 0;
  }

  /* faixa de dias: cada barra é um dia; a altura é o número de notícias */
  .strip {
    list-style: none;
    margin: 0;
    padding: 0 0 0.25rem;
    display: grid;
    grid-template-columns: repeat(30, minmax(1.1rem, 1fr));
    gap: 3px;
    overflow-x: auto;
    scrollbar-width: thin;
  }
  /* celular: só as últimas 2 semanas, sem rolagem lateral */
  @media (max-width: 40rem) {
    .strip { grid-template-columns: repeat(14, 1fr); overflow: visible; }
    .bar:nth-child(-n + 16) { display: none; }
  }
  .col {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: stretch;
    height: 4.25rem;
    text-decoration: none;
    gap: 4px;
  }
  .fill {
    display: block;
    background: var(--line);
    border-radius: 3px 3px 1px 1px;
    min-height: 3px;
  }
  a.col:hover .fill { background: var(--muted); }
  .current .fill { background: var(--ink); }
  .empty .fill { height: 3px; background: var(--soft); }
  .n {
    font-size: 0.68rem;
    text-align: center;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .current .n { color: var(--ink); font-weight: 700; }
  .h0 { height: 8%; } .h1 { height: 10%; } .h2 { height: 18%; } .h3 { height: 26%; }
  .h4 { height: 34%; } .h5 { height: 42%; } .h6 { height: 50%; } .h7 { height: 58%; }
  .h8 { height: 64%; } .h9 { height: 70%; } .h10 { height: 76%; }

  .pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    margin-top: 0.75rem;
    font-size: var(--t-sm);
  }
  .pager a { text-decoration: none; font-weight: 600; }
  .pager a:hover { text-decoration: underline; }
  .pager [rel="next"] { justify-self: end; }
  .count { color: var(--muted); }

  /* calendário (popover nativo, sem JS) */
  .calendar {
    width: min(22rem, calc(100vw - 2rem));
    max-height: min(32rem, calc(100vh - 2rem));
    overflow-y: auto;
    padding: 1rem 1.1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 18px 50px -12px rgb(16 20 28 / 0.35);
  }
  .calendar::backdrop { background: rgb(16 20 28 / 0.35); }
  .cal-head {
    display: flex; justify-content: space-between; align-items: center;
    position: sticky; top: -1rem; background: var(--surface);
    padding-block: 0.25rem 0.5rem; margin-top: -0.25rem;
  }
  .cal-title { margin: 0; font-weight: 700; }
  .month h2 {
    font-size: var(--t-sm);
    font-weight: 650;
    margin: 1rem 0 0.4rem;
  }
  .month h2::first-letter { text-transform: uppercase; }
  .grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 2px;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .wd { font-size: 0.7rem; color: var(--muted); padding-bottom: 0.2rem; }
  .d {
    display: grid; place-items: center;
    aspect-ratio: 1;
    font-size: var(--t-sm);
    border-radius: 8px;
  }
  a.d { text-decoration: none; font-weight: 650; background: var(--soft); }
  a.d:hover { background: var(--line); }
  a.d.sel { background: var(--ink); color: var(--paper); }
  .off { color: var(--muted); opacity: 0.45; }
</style>

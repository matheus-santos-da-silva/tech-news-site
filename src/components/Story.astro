---
import RichText from "./RichText.astro";
import { itemUrl, sectionName, shortDate, type Item } from "../lib/digests";

// lead: manchete da capa · second: chamada lateral da capa
// feature: primeira da seção (ocupa 2 colunas) · standard: coluna comum
interface Props { item: Item; variant: "lead" | "second" | "feature" | "standard"; showSection?: boolean }
const { item: it, variant, showSection = false } = Astro.props;
const H = variant === "lead" ? "h2" : "h3";
---
<article class:list={["story", variant]} id={it.id} aria-labelledby={`${it.id}-t`}>
  {(showSection || it.breaking || it.followUp) && (
    <p class="meta kicker">
      {showSection && <span>{sectionName(it.section)}</span>}
      {it.breaking && <span class="breaking">Quebra compatibilidade</span>}
      {it.followUp && <a class="update" href={itemUrl(it.followUp.previousId)}>Atualização de {shortDate(it.followUp.previousId.slice(0, 10))}</a>}
    </p>
  )}

  {it.image && (
    <figure class="cover">
      <img data-cover src={it.image} alt="" loading={variant === "lead" ? "eager" : "lazy"} decoding="async" referrerpolicy="no-referrer" />
    </figure>
  )}

  <H class="headline" id={`${it.id}-t`}><a href={`#${it.id}`}>{it.title}</a></H>

  {it.followUp && <p class="changed"><strong>O que mudou:</strong> <RichText text={it.followUp.whatChanged} /></p>}

  <div class="summary"><RichText as="p" text={it.summary} /></div>

  <blockquote class="why">
    <span class="kicker">Por que importa</span>
    <RichText as="p" text={it.whyItMatters} />
  </blockquote>

  <p class="sources">
    <span>{it.sources.length > 1 ? "Fontes" : "Fonte"}:</span>
    {it.sources.map((src, i) => (
      <>{i > 0 && ", "}<a href={src.url} rel="noopener noreferrer nofollow" target="_blank">{src.name}</a></>
    ))}
  </p>
</article>

<style>
  .story { min-width: 0; }
  .story:target .headline a { background: var(--soft); }

  .meta { margin: 0 0 0.5rem; display: flex; flex-wrap: wrap; gap: 0.25rem 0.75rem; }
  .breaking { color: var(--red); }
  .update { color: var(--ink); text-decoration: underline; text-underline-offset: 0.2em; }

  .cover { margin: 0 0 0.75rem; aspect-ratio: 3 / 2; overflow: hidden; background: var(--soft); }
  .cover img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .headline {
    margin: 0;
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.28rem;
    line-height: 1.18;
    letter-spacing: -0.005em;
    text-wrap: balance;
  }
  .lead .headline { font-size: clamp(1.9rem, 3.6vw, 2.6rem); font-weight: 500; line-height: 1.08; letter-spacing: -0.015em; }
  .second .headline, .feature .headline { font-size: 1.6rem; font-weight: 500; line-height: 1.12; }

  .lead .cover { aspect-ratio: 16 / 10; }

  /* abertura de seção em telas largas: foto à esquerda, texto à direita */
  @media (min-width: 66rem) {
    .feature:has(.cover) {
      display: grid;
      grid-template-columns: 1.15fr 1fr;
      column-gap: var(--col-gap);
      align-content: start;
    }
    .feature:has(.cover) > * { grid-column: 2; }
    .feature:has(.cover) > .cover { grid-column: 1; grid-row: 1 / span 8; margin: 0; align-self: start; aspect-ratio: 4 / 3; }
  }

  .changed { margin: 0.5rem 0 0; font: 400 0.85rem/1.4 var(--sans); }

  .summary { font-size: 0.97rem; line-height: 1.55; color: var(--ink); }
  .summary :global(p) { margin: 0.55rem 0 0; }
  .lead .summary { font-size: 1.06rem; }

  /* o "olho" do jornal: frase em itálico, maior que o corpo */
  .why {
    margin: 0.85rem 0 0;
    padding: 0.1rem 0 0 0.85rem;
    border-left: 2px solid var(--rule-strong);
  }
  .why :global(p) {
    margin: 0.15rem 0 0;
    font-style: italic;
    font-size: 1.04rem;
    line-height: 1.4;
  }
  .lead .why :global(p) { font-size: 1.22rem; line-height: 1.35; }

  .sources { margin: 0.75rem 0 0; font: 400 0.76rem/1.45 var(--sans); color: var(--muted); }
  .sources span { font-weight: 600; margin-right: 0.25rem; }
  .sources a { color: var(--ink); text-decoration: underline; text-decoration-color: var(--rule); text-underline-offset: 0.2em; }
  .sources a:hover { color: var(--link-hover); }
</style>

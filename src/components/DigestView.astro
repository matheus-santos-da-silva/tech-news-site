---
import RichText from "./RichText.astro";
import Story from "./Story.astro";
import { SECTIONS, hostOf, type Digest, type Item } from "../lib/digests";

interface Props { digest: Digest }
const { digest } = Astro.props;

// Capa: a manchete é a notícia do primeiro tópico do TL;DR (se tiver foto);
// senão, a primeira notícia com foto. A chamada lateral é a próxima com foto, de preferência de outra seção.
const ordered = SECTIONS.flatMap((s) => digest.items.filter((i) => i.section === s.id));
const byId = new Map(digest.items.map((i) => [i.id, i]));
const tldrLead = digest.tldr[0]?.itemId ? byId.get(digest.tldr[0].itemId) : undefined;
const lead: Item = tldrLead?.image ? tldrLead : ordered.find((i) => i.image) ?? ordered[0];
const rest = ordered.filter((i) => i !== lead);
const second: Item | undefined =
  rest.find((i) => i.image && i.section !== lead.section) ?? rest.find((i) => i.image) ?? rest[0];
const onFront = new Set([lead.id, second?.id]);

const sections = SECTIONS.map((s) => {
  const all = digest.items.filter((i) => i.section === s.id);
  const items = all.filter((i) => !onFront.has(i.id));
  // a primeira com foto abre a seção ocupando duas colunas
  const fi = items.findIndex((i) => i.image);
  const feature = fi >= 0 ? items[fi] : undefined;
  const others = items.filter((_, i) => i !== fi);
  return { ...s, total: all.length, front: all.filter((i) => onFront.has(i.id)), feature, others };
});
---
<main id="conteudo" class="page">
  <section class="front" aria-label="Capa">
    <aside class="briefing" aria-labelledby="tldr-h">
      <h2 id="tldr-h" class="kicker">O essencial do dia</h2>
      <ul>
        {digest.tldr.map((t) => (
          <li>
            {t.itemId ? <a href={`#${t.itemId}`}><RichText text={t.text} /></a> : <RichText text={t.text} />}
          </li>
        ))}
      </ul>
    </aside>
    <div class="lead-col"><Story item={lead} variant="lead" showSection /></div>
    {second && <div class="second-col"><Story item={second} variant="second" showSection /></div>}
  </section>

  {sections.map((s) => (
    <section class="section" id={s.id} aria-labelledby={`${s.id}-h`}>
      <h2 id={`${s.id}-h`} class="section-h">{s.name}</h2>
      {s.total === 0 ? (
        <p class="note">Nada relevante hoje.</p>
      ) : (
        <>
          {s.front.length > 0 && (
            <p class="note">
              Na capa: {s.front.map((i, n) => <>{n > 0 && "; "}<a href={`#${i.id}`}>{i.title}</a></>)}
            </p>
          )}
          {(s.feature || s.others.length > 0) && (
            <div class="cols">
              {s.feature && <div class="cell wide"><Story item={s.feature} variant="feature" /></div>}
              {s.others.map((it) => <div class="cell"><Story item={it} variant="standard" /></div>)}
            </div>
          )}
        </>
      )}
    </section>
  ))}

  {digest.toRead.length > 0 && (
    <section class="section to-read" id="para-ler" aria-labelledby="ler-h">
      <h2 id="ler-h" class="section-h">Para ler com calma</h2>
      <ul class="cols">
        {digest.toRead.map((r) => (
          <li class="cell">
            <span class="kicker">{hostOf(r.url)}</span>
            <a class="read-title" href={r.url} rel="noopener noreferrer nofollow" target="_blank">{r.title}</a>
            <RichText as="p" text={r.note} />
          </li>
        ))}
      </ul>
    </section>
  )}
</main>

<style>
  /* ---- capa: essencial | manchete | chamada, separados por fios */
  .front {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    padding-top: 1.25rem;
  }
  .briefing { order: 2; }
  .lead-col { order: 1; }
  .second-col { order: 3; padding-top: 1.25rem; border-top: 1px solid var(--rule); }

  @media (min-width: 48rem) {
    .front { grid-template-columns: 15rem 1fr; gap: 0; }
    .lead-col { grid-column: 2; grid-row: 1; padding-left: var(--col-gap); border-left: 1px solid var(--rule); }
    .briefing { grid-column: 1; grid-row: 1; padding-right: var(--col-gap); }
    .second-col { grid-column: 1 / -1; }
  }
  @media (min-width: 66rem) {
    .front { grid-template-columns: 15rem 1fr 19rem; }
    .second-col {
      grid-column: 3; grid-row: 1;
      padding: 0 0 0 var(--col-gap);
      margin-left: var(--col-gap);
      border-top: 0; border-left: 1px solid var(--rule);
    }
    .lead-col { padding-right: 0; }
  }

  .briefing h2 { margin: 0 0 0.25rem; color: var(--ink); }
  .briefing ul { list-style: none; margin: 0; padding: 0; }
  .briefing li {
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--rule);
    font-size: 0.92rem;
    line-height: 1.42;
  }
  .briefing li:last-child { border-bottom: 0; }
  .briefing a:hover { color: var(--link-hover); }

  /* ---- seções */
  .section { margin-top: 2.5rem; }
  .section-h {
    margin: 0 0 1rem;
    padding-top: 0.4rem;
    border-top: 2px solid var(--rule-strong);
    font: 700 0.95rem/1.2 var(--sans);
  }
  .note { margin: -0.4rem 0 1rem; font: 400 0.85rem/1.45 var(--sans); color: var(--muted); }
  .note a { color: var(--ink); text-decoration: underline; text-decoration-color: var(--rule); }

  /* colunas com fio vertical: cada célula tem borda à esquerda; a da 1ª coluna fica fora do recorte */
  .cols {
    list-style: none;
    padding: 0;
    margin: 0 calc(-1 * var(--col-gap));
    display: grid;
    grid-template-columns: 1fr;
    row-gap: 1.5rem;
    overflow: hidden;
  }
  .cell {
    padding-inline: var(--col-gap);
    border-left: 1px solid var(--rule);
    margin-left: -1px;
    min-width: 0;
  }
  @media (max-width: 39.99rem) {
    .cell + .cell { padding-top: 1.5rem; border-top: 1px solid var(--rule); }
  }
  @media (min-width: 40rem) {
    .cols { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 66rem) {
    .cols { grid-template-columns: repeat(3, 1fr); }
    .wide { grid-column: span 2; }
  }

  /* ---- para ler com calma */
  .to-read .cols { row-gap: 1.25rem; }
  @media (min-width: 66rem) { .to-read .cols { grid-template-columns: repeat(4, 1fr); } }
  .read-title { display: block; margin-top: 0.3rem; font: 600 1.02rem/1.25 var(--serif); }
  .to-read :global(p) { margin: 0.35rem 0 0; font-size: 0.88rem; line-height: 1.45; color: var(--muted); }
</style>

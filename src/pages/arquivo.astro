---
import Base from "../layouts/Base.astro";
import DayHeader from "../components/DayHeader.astro";
import RichText from "../components/RichText.astro";
import { allDigests, dayUrl, weekday } from "../lib/digests";

const all = allDigests();
const byMonth = new Map<string, typeof all>();
for (const d of all) {
  const ym = d.date.slice(0, 7);
  if (!byMonth.has(ym)) byMonth.set(ym, []);
  byMonth.get(ym)!.push(d);
}
const monthLabel = (ym: string) =>
  new Intl.DateTimeFormat("pt-BR", { timeZone: "UTC", month: "long", year: "numeric" }).format(new Date(`${ym}-15T12:00:00Z`));
---
<Base title="Todas as edições · Tech News" description="Arquivo de todos os resumos diários de tecnologia.">
  <DayHeader />
  <main id="conteudo" class="page">
    <h1>Todas as edições</h1>
    <p class="sub">{all.length} edições, da mais recente à mais antiga.</p>
    {[...byMonth].map(([ym, days]) => (
      <section aria-labelledby={`m-${ym}`}>
        <h2 id={`m-${ym}`}>{monthLabel(ym)}</h2>
        <ol>
          {days.map((d) => (
            <li>
              <a href={dayUrl(d.date)}>
                <span class="day">{Number(d.date.slice(8))}</span>
                <span class="meta">{weekday(d.date)} · {d.items.length} notícias</span>
                <span class="lead"><RichText text={d.tldr[0].text} /></span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </main>
</Base>

<style>
  main { max-width: 48rem; }
  h1 { margin: 2rem 0 0.25rem; font: 500 clamp(2rem, 6vw, 2.8rem)/1.05 var(--serif); letter-spacing: -0.015em; }
  .sub { margin: 0; color: var(--muted); font: 400 0.85rem/1.4 var(--sans); }
  h2 {
    margin: 2.25rem 0 0;
    padding-top: 0.4rem;
    border-top: 2px solid var(--rule-strong);
    font: 700 0.95rem/1.2 var(--sans);
  }
  h2::first-letter { text-transform: uppercase; }
  ol { list-style: none; margin: 0; padding: 0; }
  li + li { border-top: 1px solid var(--rule); }
  li a {
    display: grid;
    grid-template-columns: 3rem 1fr;
    grid-template-areas: "day meta" "day lead";
    gap: 0.15rem 0.9rem;
    padding: 0.9rem 0;
  }
  li a:hover .lead { color: var(--link-hover); }
  .day { grid-area: day; font: 500 2.1rem/1 var(--serif); font-variant-numeric: lining-nums tabular-nums; }
  .meta { grid-area: meta; font: 500 0.75rem/1.3 var(--sans); color: var(--muted); }
  .meta::first-letter { text-transform: uppercase; }
  .lead { grid-area: lead; font-size: 1rem; line-height: 1.45; }
</style>
